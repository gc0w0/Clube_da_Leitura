@model Clube_da_Leitura.WebApp.Models.EditarReservaViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Editar Reserva</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataReserva" class="control-label"></label>
                <input asp-for="DataReserva" class="form-control" />
                <span asp-validation-for="DataReserva" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AmigoId" class="control-label">Amigo: </label>
                <select asp-for="AmigoId" asp-items="@Model.AmigosDisponiveis" class="form-select">
                    <option value="">Nenhum amigo selecionado</option>
                </select>
                <span asp-validation-for="AmigoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RevistaId" class="control-label">Revista: </label>
                <select asp-for="RevistaId" asp-items="@Model.RevistasDisponiveis" class="form-select">
                    <option value="">Nenhuma revista selecionada</option>
                </select>
                <span asp-validation-for="RevistaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

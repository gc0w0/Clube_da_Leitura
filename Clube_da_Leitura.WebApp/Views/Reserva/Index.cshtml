@using Clube_da_Leitura.ModuloReserva
@model List<Reserva>

@{
    ViewData["Title"] = "Index";
}

<h1>Reservas</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Revista</th>
            <th>Amigo</th>
            <th>Data da Reserva</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var reserva in Model) {
        <tr>
            <td>@reserva.Revista.Titulo</td>
            <td>@reserva.Amigo.Nome</td>
            <td>@(reserva.DataReserva.ToString("dd/MM/yyyy"))</td>
            <td>@reserva.Situacao</td>
            <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@reserva.Id"> Editar </a>
                    <a class="btn btn-warning text-light" asp-action="Details" asp-route-id="@reserva.Id"> Visualizar </a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@reserva.Id"> Excluir </a>
            </td>
        </tr>
}
    </tbody>
</table>

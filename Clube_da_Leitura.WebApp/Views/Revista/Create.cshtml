@using Clube_da_Leitura.ModuloCaixa;
@model Clube_da_Leitura.ModuloRevista.Revista


@{
    ViewData["Title"] = "Create";
    List<Caixa> caixas;
}

<h1>Create</h1>

<h4>Revista</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Titulo" class="control-label">Título</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumeroEdicao" class="control-label">Numero da Edição</label>
                <input asp-for="NumeroEdicao" class="form-control" />
                <span asp-validation-for="NumeroEdicao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnoPublicacao" class="control-label">Ano de Publicação</label>
                <input asp-for="AnoPublicacao" class="form-control" />
                <span asp-validation-for="AnoPublicacao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="status" class="control-label">Status da Revista</label>
                <input asp-for="status" class="form-control" />
                <span asp-validation-for="status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Caixa.Id" class="control-label">ID da Caixa</label>
                <input asp-for="Caixa.Id" class="form-control" />
                <span asp-validation-for="Caixa.Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

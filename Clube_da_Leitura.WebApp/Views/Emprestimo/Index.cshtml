@using Clube_da_Leitura.ModuloEmprestimo;

@model List<Emprestimo>

@{
    ViewData["Title"] = "Index";
}

<h1>Emprestimos</h1>

<p>
    <a asp-action="Create">Inserir</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Data do emprestimo</th>
            <th>Data de devolução</th>
            <th>Data prevista de devolução</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var emprestimo in Model) 
    {
        <tr>
            <td>@emprestimo.Id</td>
            <td>@emprestimo.DataEmprestimo</td>
            <td>@emprestimo.DataDevolucao</td>
            <td>@emprestimo.DataPrevistaDevolucao</td>
            <td>@emprestimo.Situacao</td>
            <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@emprestimo.Id"> Editar </a>
                    <a class="btn btn-warning" asp-action="Details" asp-route-id="@emprestimo.Id"> Visualizar </a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@emprestimo.Id"> Excluir </a>
            </td>
        </tr>
    }
    </tbody>
</table>

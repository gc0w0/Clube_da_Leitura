@using Clube_da_Leitura.ModuloEmprestimo;
@using Clube_da_Leitura.ModuloAmigo;
@using Clube_da_Leitura.ModuloRevista;
@model List<Emprestimo>

@{
    ViewData["Title"] = "Index";
}

<h1>Emprestimos</h1>

<p>
    <a asp-action="Create">Cadastrar emprestimo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Amigo</th>
            <th>Revista</th>
            <th>Data do emprestimo</th>
            <th>Data de devolução</th>
            <th>Data prevista de devolução</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var emprestimo in Model) {
        <tr>
            <td>@emprestimo.Amigo.Nome</td>
            <td>@emprestimo.Revista.Titulo</td>
            <td>@(emprestimo.DataEmprestimo.HasValue ? emprestimo.DataEmprestimo.Value.ToString("dd/MM/yyyy") : "Data não informada")</td>
            <td>@(emprestimo.DataDevolucao.HasValue ? emprestimo.DataDevolucao.Value.ToString("dd/MM/yyyy") : "Ainda não devolvido")</td>
            <td>@(emprestimo.DataPrevistaDevolucao.HasValue ? emprestimo.DataPrevistaDevolucao.Value.ToString("dd/MM/yyyy") : "Data não informada")</td>
            <td>@emprestimo.Situacao</td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@emprestimo.Id"> Editar </a>
                <a class="btn btn-warning text-light" asp-action="Details" asp-route-id="@emprestimo.Id"> Visualizar </a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@emprestimo.Id"> Excluir </a>
            </td>
        </tr>
}
    </tbody>
</table>

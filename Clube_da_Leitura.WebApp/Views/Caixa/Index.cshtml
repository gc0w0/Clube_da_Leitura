@using Clube_da_Leitura.ModuloCaixa

@model List<Caixa>

@{
    ViewData["Title"] = "Index";
}

<h1>Caixas</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Etiqueta
            </th>
            <th>
                Cor
            </th>
            <th>
                Dias
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var caixa in Model) {
        <tr>
            <td>
                @caixa.Etiqueta
            </td>
            <td>
                    @caixa.Cor
            </td>
            <td>
                    @caixa.Dias
            </td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@caixa.Id"> Editar </a>
                    <a class="btn btn-warning text-light" asp-action="Details" asp-route-id="@caixa.Id"> Visualizar </a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@caixa.Id"> Excluir </a>
                </td>
        </tr>
}
    </tbody>
</table>
